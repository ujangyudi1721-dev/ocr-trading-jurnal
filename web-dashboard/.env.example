# Copy this file to .env.local and fill in the real values.
# NONE of these should ever be prefixed with NEXT_PUBLIC_ — they must stay
# server-only (service role key + dashboard password bypass RLS/auth
# entirely, so leaking them to the browser bundle would be a real security
# issue).

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Service role key (Supabase Dashboard > Settings > API Keys > service_role).
# Bypasses Row Level Security — used server-side only to read this single
# user's trading data.
SUPABASE_SERVICE_ROLE_KEY=

# auth.users.id of the one fixed account used by the mobile app (see
# lib/services/supabase_service.dart SUPABASE_EMAIL/SUPABASE_PASSWORD).
TRADING_USER_ID=

# Password required to view the dashboard (simple gate, not a full auth
# system — this app is for one person).
DASHBOARD_PASSWORD=

# Random secret used to sign the login session cookie. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=
